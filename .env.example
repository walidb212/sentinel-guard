# sentinel-guard environment. Every value is optional; an empty value means unset.
# Local-only mode (the default) needs none of them and makes no network call.

# Connected mode: setting SENTINEL_API_KEY switches it on (or SENTINEL_MODE=connected).
SENTINEL_MODE=
SENTINEL_API=
SENTINEL_API_KEY=
SENTINEL_EXPLORER=
SENTINEL_AMOUNT_DECIMALS=
SENTINEL_API_TIMEOUT=

# Operator config (read only) and guard state (written). Defaults: shipped example config, ~/.sentinel-guard/state
SENTINEL_CONFIG_DIR=
SENTINEL_STATE_DIR=

# Mandate policy
SENTINEL_UNREGISTERED=
SENTINEL_ISSUER=

# Human approval tools over MCP (absent unless set)
SENTINEL_APPROVER_TOKEN=

# Streamable HTTP transport
SENTINEL_TRANSPORT=
SENTINEL_HOST=
SENTINEL_PORT=
SENTINEL_HTTP_PATH=
SENTINEL_HTTP_TOKEN=
SENTINEL_ALLOWED_HOSTS=
SENTINEL_ALLOWED_ORIGINS=

# Optional LLM judgement: off | anthropic | bedrock
SENTINEL_LLM=
SENTINEL_LLM_MODEL=
SENTINEL_LLM_TIMEOUT=
ANTHROPIC_API_KEY=
AWS_REGION=

# Misc
SENTINEL_CANARY=
SENTINEL_LOG_LEVEL=
